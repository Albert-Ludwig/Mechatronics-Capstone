# Merged into THIS ROS distribution's installed nav2_bringup default YAML.
# Controller/planner implementations remain the distribution's official defaults.
amcl:
  ros__parameters:
    base_frame_id: base_footprint
    odom_frame_id: odom
    global_frame_id: map
    scan_topic: /scan
    set_initial_pose: true
    laser_max_range: 20.0
    max_particles: 1500
    min_particles: 500
    update_min_d: 0.10
    update_min_a: 0.10
controller_server:
  ros__parameters:
    controller_frequency: 20.0
    progress_checker:
      required_movement_radius: 0.25
      movement_time_allowance: 20.0
    general_goal_checker:
      xy_goal_tolerance: 0.18
      yaw_goal_tolerance: 0.20
    FollowPath:
      # MPPI settings shared by Jazzy and Lyrical; no custom controller.
      vx_max: 0.30
      vx_min: -0.15
      vy_max: 0.0
      wz_max: 1.0
      batch_size: 1000
      visualize: false
      publish_optimal_trajectory: false
local_costmap:
  local_costmap:
    ros__parameters:
      robot_radius: 0.22
      resolution: 0.05
      inflation_layer:
        inflation_radius: 0.55
      voxel_layer:
        publish_voxel_map: false
        scan:
          topic: /scan
          inf_is_valid: true
          obstacle_max_range: 5.0
          raytrace_max_range: 6.0
global_costmap:
  global_costmap:
    ros__parameters:
      robot_radius: 0.22
      resolution: 0.05
      inflation_layer:
        inflation_radius: 0.55
      obstacle_layer:
        scan:
          topic: /scan
          inf_is_valid: true
          obstacle_max_range: 5.0
          raytrace_max_range: 6.0
waypoint_follower:
  ros__parameters:
    stop_on_failure: true
    waypoint_task_executor_plugin: wait_at_waypoint
    wait_at_waypoint:
      plugin: nav2_waypoint_follower::WaitAtWaypoint
      enabled: true
      waypoint_pause_duration: 5000
velocity_smoother:
  ros__parameters:
    max_velocity: [0.30, 0.0, 1.0]
    min_velocity: [-0.15, 0.0, -1.0]
